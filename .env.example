# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=bidsphere_user
DB_PASSWORD=bidsphere_pass
DB_NAME=bidsphere_db
DB_ROOT_PASSWORD=bidsphere_root

# JWT Authentication & Security
SECRET_KEY=bidsphere_super_secret_jwt_key_change_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Frontend Configuration
API_BASE_URL=http://localhost:8000/api/v1
STREAMLIT_PORT=8501

# Default Admin Bootstrap
ADMIN_EMAIL=admin@bidsphere.com
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=System Administrator
ADMIN_INITIAL_PASSWORD=Admin@BidSphere2026!
